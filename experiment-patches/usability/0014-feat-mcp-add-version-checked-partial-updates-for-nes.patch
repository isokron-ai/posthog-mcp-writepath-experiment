+export const surveyUpdateQuestionTool = (): ToolBase<typeof SurveyUpdateQuestionSchema, PartialUpdateReceipt> => ({
+    name: 'survey-update-question',
+    schema: SurveyUpdateQuestionSchema,
+    handler: surveyUpdateQuestion,
+})
