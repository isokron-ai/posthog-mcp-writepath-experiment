+function isEmptyDefault(value: unknown): boolean {
+    if (value === undefined || value === null || value === false || value === '') {
+        return true
+    }
+    if (Array.isArray(value)) {
+        return value.length === 0
+    }
+    return isPlainRecord(value) && Object.keys(value).length === 0
