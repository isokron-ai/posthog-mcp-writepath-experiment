+ */
+function resolveReceiptPlan(
+    config: ToolConfig,
+    httpMethod: string,
+    hasBody: boolean,
+    softDeleteField: string | undefined
+): ReceiptPlan | undefined {
+    const receipt = config.response?.receipt
