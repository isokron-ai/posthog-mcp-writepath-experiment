+/**
+ * Atomic-write and batch tools. The patterns they share are written up in
+ * services/mcp/docs/atomic-and-batch-tools.md:
+ *
+ * - batch.ts: validate every item, then write best-effort with a result per item (and dry_run)
+ * - versionGuard.ts: version-checked read-merge-write for partial updates
+ */
+import type { ToolBase, ZodObjectAny } from '@/tools/types'
+
+import { annotationsBatchCreateTool, annotationsBatchDeleteTool } from './annotationsBatch'
+import insightsBatchUpdate from './insightsBatchUpdate'
+
+export const ATOMIC_TOOLS: Record<string, () => ToolBase<ZodObjectAny>> = {
+    'insights-batch-update': insightsBatchUpdate,
+    'annotations-batch-create': annotationsBatchCreateTool,
+    'annotations-batch-delete': annotationsBatchDeleteTool,
+}
diff --git a/services/mcp/src/tools/atomic/insightsBatchUpdate.ts b/services/mcp/src/tools/atomic/insightsBatchUpdate.ts
new file mode 100644
index 00000000000..f348e5c586e
--- /dev/null
+++ b/services/mcp/src/tools/atomic/insightsBatchUpdate.ts
@@ -0,0 +1,200 @@
+/**
+ * insights-batch-update: change name, description, tags, favorited or soft-delete across many
+ * insights in one call, with a result per insight. See batch.ts for the semantics.
+ *
+ * `tags` replaces an insight's tags. `add_tags` and `remove_tags` edit them in place, which is a
+ * read-merge-write, so those items go through the version guard: if the insight changed between
+ * the validation read and the write, that item reports `conflict` and is not written.
+ */
+import { z } from 'zod'
+
+import * as orvalSchemas from '@/generated/product_analytics/api'
+import { canonicalJson } from '@/lib/plain-object'
+import type { Context, ToolBase } from '@/tools/types'
+
+import { MAX_BATCH_ITEMS, runBatch, type BatchResult, type ItemResult } from './batch'
+import { type ApiObject, insightResource, resolveInsightId } from './resources'
+import { versionCheckedUpdate, type VersionedResource } from './versionGuard'
+
+const body = orvalSchemas.InsightsPartialUpdateBody().shape
+
+const TagList = z.array(z.string().min(1)).max(50)
+
+export const InsightBatchItemSchema = z
+    .object({
+        id: z.union([z.number().int(), z.string().min(1)]).describe('Insight id or short_id.'),
+        name: body.name.describe('New name.'),
+        description: body.description.describe('New description. Null clears it.'),
+        tags: TagList.optional().describe("Replace all of the insight's tags with this list."),
+        add_tags: TagList.optional().describe('Tags to add, keeping the existing ones.'),
+        remove_tags: TagList.optional().describe('Tags to remove, keeping the others.'),
+        favorited: z.boolean().optional().describe('Star or unstar the insight.'),
+        deleted: z
+            .literal(true)
+            .optional()
+            .describe('Soft-delete the insight, as insight-delete does. Insights have no separate archive state.'),
+    })
+    .strict()
+    .superRefine((item, ctx) => {
+        const fields = ['name', 'description', 'tags', 'add_tags', 'remove_tags', 'favorited', 'deleted'] as const
+        if (!fields.some((field) => item[field] !== undefined)) {
+            ctx.addIssue({ code: 'custom', message: `give at least one of ${fields.join(', ')}` })
+        }
+        if (item.tags !== undefined && (item.add_tags !== undefined || item.remove_tags !== undefined)) {
+            ctx.addIssue({
+                code: 'custom',
+                message: 'use either `tags` (replace) or `add_tags`/`remove_tags`, not both',
+            })
+        }
+    })
+    .describe('One insight and the changes to make to it.')
+
+export type InsightBatchItem = z.infer<typeof InsightBatchItemSchema>
+
+export const InsightsBatchUpdateSchema = z.object({
+    items: z
+        .array(InsightBatchItemSchema)
+        .min(1)
+        .max(MAX_BATCH_ITEMS)
+        .describe(`The insights to change, at most ${MAX_BATCH_ITEMS} per call.`),
+    dry_run: z
+        .boolean()
+        .optional()
+        .describe('Validate every item and report what would change, without writing anything.'),
+    stop_on_error: z
+        .boolean()
+        .optional()
+        .describe('Start no further writes after the first failed one. The rest are reported as skipped.'),
+})
+
+const uniq = (tags: readonly string[]): string[] => [...new Set(tags)]
+
+/** The PATCH body for `item`, computed from the insight as it is now. Only fields that change are kept. */
+export function planInsightChange(item: InsightBatchItem, current: ApiObject): Record<string, unknown> {
+    const next: Record<string, unknown> = {}
+    const currentTags = Array.isArray(current.tags) ? (current.tags as string[]) : []
+    if (item.name !== undefined) {
+        next.name = item.name
+    }
+    if (item.description !== undefined) {
+        next.description = item.description
+    }
+    if (item.favorited !== undefined) {
+        next.favorited = item.favorited
+    }
+    if (item.deleted) {
+        next.deleted = true
+    }
+    if (item.tags !== undefined) {
+        next.tags = uniq(item.tags)
+    } else if (item.add_tags !== undefined || item.remove_tags !== undefined) {
+        const remove = new Set(item.remove_tags ?? [])
+        next.tags = uniq([...currentTags, ...(item.add_tags ?? [])]).filter((tag) => !remove.has(tag))
+    }
+    for (const [field, value] of Object.entries(next)) {
+        const same =
+            field === 'tags'
+                ? canonicalJson([...(value as string[])].sort()) === canonicalJson([...currentTags].sort())
+                : canonicalJson(value) === canonicalJson(current[field] ?? (field === 'deleted' ? false : null))
+        if (same) {
+            delete next[field]
+        }
+    }
+    return next
+}
+
+function changedFields(before: ApiObject, after: ApiObject, fields: string[]): Record<string, [unknown, unknown]> {
+    const out: Record<string, [unknown, unknown]> = {}
+    for (const field of fields) {
+        out[field] = [before[field] ?? (field === 'deleted' ? false : null), after[field] ?? null]
+    }
+    return out
+}
+
+type PreparedItem = {
+    item: InsightBatchItem
+    id: number
+    resource: VersionedResource<ApiObject>
+    before: ApiObject
+    body: Record<string, unknown>
+}
+
+const receiptBase = (index: number, id: number, insight: ApiObject): ItemResult => ({
+    index,
+    status: 'ok',
+    id,
+    short_id: insight.short_id as string | undefined,
+    name: (insight.name as string | null | undefined) ?? null,
+})
+
+export async function insightsBatchUpdate(
+    context: Context,
+    params: z.infer<typeof InsightsBatchUpdateSchema>
+): Promise<BatchResult> {
+    const projectId = await context.stateManager.getProjectId()
+    return await runBatch<InsightBatchItem, PreparedItem>({
+        items: params.items,
+        dryRun: params.dry_run ?? false,
+        stopOnError: params.stop_on_error ?? false,
+        prepare: async (item, index) => {
+            const id = await resolveInsightId(context, projectId, item.id)
+            const resource = insightResource(context, projectId, id)
+            const before = await resource.read()
+            const planned = planInsightChange(item, before)
+            const fields = Object.keys(planned)
+            if (fields.length === 0) {
+                return {
+                    valid: true,
+                    prepared: { item, id, resource, before, body: planned },
+                    preview: { ...receiptBase(index, id, before), status: 'unchanged' },
+                    skipWrite: true,
+                }
+            }
+            return {
+                valid: true,
+                prepared: { item, id, resource, before, body: planned },
+                preview: {
+                    ...receiptBase(index, id, before),
+                    status: 'would_change',
+                    changed: changedFields(before, planned, fields),
+                },
+            }
+        },
+        execute: async ({ item, id, resource, before, body: planned }, index) => {
+            const merges = item.add_tags !== undefined || item.remove_tags !== undefined
+            let after: ApiObject
+            let written: Record<string, unknown> = planned
+            if (merges) {
+                const result = await versionCheckedUpdate(
+                    resource,
+                    (current) => {
+                        const next = planInsightChange(item, current)
+                        return Object.keys(next).length > 0 ? { body: next } : { unchanged: true }
+                    },
+                    { base: before }
+                )
+                if (result.status !== 'ok' || !result.after) {
+                    return { ...receiptBase(index, id, before), status: 'unchanged' }
+                }
+                after = result.after
+                written = result.body ?? planned
+            } else {
+                after = await resource.write(planned, before)
+            }
+            return {
+                ...receiptBase(index, id, after),
+                changed: changedFields(
+                    before,
+                    { ...after, ...(written.deleted ? { deleted: true } : {}) },
+                    Object.keys(written)
+                ),
+            }
+        },
+    })
+}
+
+export default (): ToolBase<typeof InsightsBatchUpdateSchema, BatchResult> => ({
+    name: 'insights-batch-update',
+    schema: InsightsBatchUpdateSchema,
+    handler: insightsBatchUpdate,
+})
diff --git a/services/mcp/src/tools/atomic/resources.ts b/services/mcp/src/tools/atomic/resources.ts
new file mode 100644
index 00000000000..db13270d5b9
--- /dev/null
+++ b/services/mcp/src/tools/atomic/resources.ts
@@ -0,0 +1,118 @@
+/**
+ * The REST objects the atomic tools read and write, each described once as a VersionedResource:
+ * where it lives, which fields act as its version marker, and how it is written.
+ *
+ * Version markers per endpoint (what the API exposes; the backend is unchanged):
+ * - insight: `updated_at` and `last_modified_at`. No precondition field, so the re-read is the guard.
+ * - feature flag: `version` (a write counter) and `updated_at`. The PATCH accepts `version` and
+ *   refuses a stale one with 409 for flags whose `filters.version` is 2; we always send it.
+ * - survey: no marker is exposed. The guard compares the content of the fields being written
+ *   (the questions), which a concurrent edit of those fields always changes.
+ */
+import { PostHogApiError } from '@/lib/errors'
+import { canonicalJson } from '@/lib/plain-object'
+import type { Context } from '@/tools/types'
+
+import type { VersionedResource } from './versionGuard'
+
+export type ApiObject = Record<string, unknown>
+
+const enc = (value: string | number): string => encodeURIComponent(String(value))
+
+export function projectPath(projectId: string, suffix: string): string {
+    return `/api/projects/${enc(projectId)}/${suffix}`
+}
+
+/** Accepts a numeric insight id or a short_id and returns the numeric id. */
+export async function resolveInsightId(context: Context, projectId: string, id: string | number): Promise<number> {
+    if (typeof id === 'number') {
+        return id
+    }
+    const trimmed = id.trim()
+    if (/^\d+$/.test(trimmed)) {
+        return Number(trimmed)
+    }
+    const page = await context.api.request<{ results?: { id: number; short_id?: string }[] }>({
+        method: 'GET',
+        path: projectPath(projectId, 'insights/'),
+        query: { short_id: trimmed, limit: 1 },
+    })
+    const match = page.results?.find((row) => row.short_id === trimmed)
+    if (!match) {
+        throw new PostHogApiError({
+            status: 404,
+            statusText: 'Not Found',
+            body: '',
+            url: '',
+            method: 'GET',
+            message: `No insight with short_id "${trimmed}" in this project.`,
+        })
+    }
+    return match.id
+}
+
+export function insightResource(context: Context, projectId: string, id: number): VersionedResource<ApiObject> {
+    const path = projectPath(projectId, `insights/${enc(id)}/`)
+    return {
+        kind: 'insight',
+        id,
+        lockKey: `insight:${projectId}:${id}`,
+        markerFields: ['updated_at', 'last_modified_at'],
+        agentVersion: (insight) => (insight.updated_at as string | undefined) ?? null,
+        read: () => context.api.request<ApiObject>({ method: 'GET', path }),
+        write: (body) => context.api.request<ApiObject>({ method: 'PATCH', path, body }),
+    }
+}
+
+export function featureFlagResource(context: Context, projectId: string, id: number): VersionedResource<ApiObject> {
+    const path = projectPath(projectId, `feature_flags/${enc(id)}/`)
+    const counter = (flag: ApiObject): number | undefined =>
+        typeof flag.version === 'number' ? flag.version : undefined
+    return {
+        kind: 'feature flag',
+        id,
+        lockKey: `feature_flag:${projectId}:${id}`,
+        markerFields: ['version', 'updated_at'],
+        agentVersion: (flag) => counter(flag) ?? null,
+        read: () => context.api.request<ApiObject>({ method: 'GET', path }),
+        // The API's own precondition: a flag whose filters.version is 2 refuses a stale version with 409.
+        write: (body, base) =>
+            context.api.request<ApiObject>({
+                method: 'PATCH',
+                path,
+                body: counter(base) !== undefined ? { ...body, version: counter(base) } : body,
+            }),
+        expectedCounterAfterWrite: (base) => (counter(base) !== undefined ? counter(base)! + 1 : undefined),
+        counter,
+    }
+}
+
+/** A survey exposes no version marker, so its version is a short hash of its questions. */
+export function surveyQuestionsVersion(survey: ApiObject): string {
+    let hash = 0x811c9dc5
+    const text = canonicalJson(survey.questions ?? null)
+    for (let i = 0; i < text.length; i++) {
+        hash ^= text.charCodeAt(i)
+        hash = Math.imul(hash, 0x01000193) >>> 0
+    }
+    return `q-${hash.toString(16).padStart(8, '0')}`
+}
+
+export function surveyResource(context: Context, projectId: string, id: string): VersionedResource<ApiObject> {
+    const path = projectPath(projectId, `surveys/${enc(id)}/`)
+    return {
+        kind: 'survey',
+        id,
+        lockKey: `survey:${projectId}:${id}`,
+        markerFields: ['updated_at'],
+        agentVersion: surveyQuestionsVersion,
+        read: () => context.api.request<ApiObject>({ method: 'GET', path }),
+        write: (body) => context.api.request<ApiObject>({ method: 'PATCH', path, body }),
+    }
+}
+
+/** A small public link for receipts, built the same way withPostHogUrl builds it. */
+export async function appUrl(context: Context, path: string): Promise<string> {
+    const projectId = await context.stateManager.getProjectId()
+    return `${context.api.getProjectBaseUrl(projectId)}${path}`
+}
diff --git a/services/mcp/src/tools/atomic/validation.ts b/services/mcp/src/tools/atomic/validation.ts
new file mode 100644
index 00000000000..5290a4f6573
--- /dev/null
+++ b/services/mcp/src/tools/atomic/validation.ts
@@ -0,0 +1,98 @@
+/**
+ * Validation helpers shared by the atomic-write and batch tools.
+ *
+ * The tools keep their own input schemas small (a query is a plain object in the input schema,
+ * so the tool stays far under the registry's schema size limit), then validate each nested value
+ * here against the same schema the single-object tool uses. One schema, two entry points.
+ */
+import type { z } from 'zod'
+
+import { isRecord } from '@/lib/plain-object'
+import { GENERATED_TOOL_MAP } from '@/tools/generated'
+import type { ZodObjectAny } from '@/tools/types'
+
+type Issue = z.core.$ZodIssue
+
+function issueLines(issues: readonly Issue[], prefix: string[]): string[] {
+    const lines: string[] = []
+    for (const issue of issues) {
+        const path = [...prefix, ...issue.path.map(String)]
+        if (issue.code === 'invalid_union' && Array.isArray(issue.errors) && issue.errors.length > 0) {
+            // Report the branch the value was closest to: the one that accepted its `kind`, with the
+            // fewest problems. Listing every branch's complaint would bury the one that matters.
+            const branches = issue.errors as Issue[][]
+            const ranked = [...branches].sort((a, b) => score(a) - score(b))
+            lines.push(...issueLines(ranked[0]!, path))
+            continue
+        }
+        lines.push(`${path.join('.') || '(root)'}: ${issue.message}`)
+    }
+    return lines
+}
+
+function score(branch: readonly Issue[]): number {
+    const kindMiss = branch.some((issue) => issue.path[issue.path.length - 1] === 'kind') ? 1000 : 0
+    return kindMiss + branch.length
+}
+
+/** `a.b: message; c: message`, at most `max` entries. */
+export function formatIssues(error: z.ZodError, prefix: string[] = [], max = 5): string {
+    const lines = issueLines(error.issues, prefix)
+    const shown = lines.slice(0, max)
+    return shown.join('; ') + (lines.length > max ? `; and ${lines.length - max} more` : '')
+}
+
+function toolShape(toolName: string): Record<string, z.ZodType> | undefined {
+    const factory = GENERATED_TOOL_MAP[toolName]
+    const schema = factory?.().schema as ZodObjectAny | undefined
+    return schema && 'shape' in schema ? (schema.shape as Record<string, z.ZodType>) : undefined
+}
+
+let insightQuerySchema: z.ZodType | undefined
+
+/** The `query` schema of insight-create, so a tile is checked exactly as insight-create would check it. */
+export function getInsightQuerySchema(): z.ZodType {
+    if (!insightQuerySchema) {
+        const schema = toolShape('insight-create')?.query
+        if (!schema) {
+            throw new Error('insight-create is not registered, so a query cannot be validated')
+        }
+        insightQuerySchema = schema
+    }
+    return insightQuerySchema
+}
+
+/** Returns an error message for an invalid insight query, or undefined when it is valid. */
+export function validateInsightQuery(query: unknown, prefix: string[] = ['query']): string | undefined {
+    if (!isRecord(query)) {
+        return `${prefix.join('.')}: must be an object with a \`kind\``
+    }
+    const parsed = getInsightQuerySchema().safeParse(query)
+    return parsed.success ? undefined : formatIssues(parsed.error, prefix)
+}
+
+let annotationItemSchema: ZodObjectAny | undefined
+
+/** The input schema of annotation-create: the batch item is the single tool's input, unchanged. */
+export function getAnnotationCreateSchema(): ZodObjectAny {
+    if (!annotationItemSchema) {
+        const schema = GENERATED_TOOL_MAP['annotation-create']?.().schema as ZodObjectAny | undefined
+        if (!schema) {
+            throw new Error('annotation-create is not registered')
+        }
+        annotationItemSchema = schema
+    }
+    return annotationItemSchema
+}
+
+/**
+ * The query an insight runs. A visualization node (InsightVizNode, DataTableNode, DataVisualizationNode,
+ * BIVisualizationNode) wraps the runnable query in `source`; anything else runs as it is.
+ */
+export function runnableQuery(query: Record<string, unknown>): Record<string, unknown> {
+    const wrappers = ['InsightVizNode', 'DataTableNode', 'DataVisualizationNode', 'BIVisualizationNode']
+    if (typeof query.kind === 'string' && wrappers.includes(query.kind) && isRecord(query.source)) {
+        return query.source
+    }
+    return query
+}
diff --git a/services/mcp/src/tools/atomic/versionGuard.ts b/services/mcp/src/tools/atomic/versionGuard.ts
new file mode 100644
index 00000000000..fbe0eb9f2c4
--- /dev/null
+++ b/services/mcp/src/tools/atomic/versionGuard.ts
@@ -0,0 +1,168 @@
+/**
+ * Version-checked read-merge-write.
+ *
+ * A partial update in the MCP layer has to read the object, change one part, and write the field
+ * back whole, because the REST endpoints replace nested arrays (flag conditions, survey questions,
+ * an insight's query) as a unit. Done naively, a second writer's change that lands between the read
+ * and the write is silently overwritten: the lost-update bug. This module wraps that sequence:
+ *
+ *   1. Lock the object inside this process (KeyedMutex), so two MCP updates of the same object
+ *      through this server run one after the other instead of racing.
+ *   2. Read the object, and refuse when the agent's `base_version` no longer matches.
+ *   3. Build the change from what was just read (the caller's `plan`), and validate it.
+ *   4. Re-read the object immediately before the write and compare its version marker and the
+ *      fields being written. If anything changed, write nothing and raise a WriteConflictError.
+ *   5. Write, sending the endpoint's own precondition when it has one (a flag's `version`), and map
+ *      the API's 409 to the same conflict.
+ *   6. Where the endpoint keeps a write counter (a flag's `version`), check that the write moved it
+ *      by exactly one. More than one means another write landed in the window; the receipt says so.
+ *
+ * What remains: between step 4's re-read and step 5's write (one API round trip) a writer outside
+ * this process (the UI, another server instance) can still land a change, and an endpoint without
+ * a precondition will accept our write on top of it. For flags step 6 detects this after the fact;
+ * for insights and surveys nothing in the API can.
+ */
+import { canonicalJson, isRecord } from '@/lib/plain-object'
+
+import { KeyedMutex, objectLocks } from './concurrency'
+import { WriteConflictError, errorStatus } from './errors'
+
+export interface VersionedResource<T extends Record<string, unknown>> {
+    /** Human name used in messages, e.g. `insight`. */
+    kind: string
+    id: string | number
+    /** Lock key; include the project so two projects never share a lock. */
+    lockKey: string
+    read(): Promise<T>
+    /** Fields that change on every accepted write (updated_at, last_modified_at, version). Missing ones are skipped. */
+    markerFields: readonly string[]
+    /** The value an agent sends back as `base_version`: a flag's version, an insight's updated_at. */
+    agentVersion(object: T): string | number | null | undefined
+    write(body: Record<string, unknown>, base: T): Promise<T>
+    /** For an endpoint with a write counter: what the counter must read after exactly one write on `base`. */
+    expectedCounterAfterWrite?(base: T): number | undefined
+    counter?(object: T): number | undefined
+}
+
+/** What the caller wants written, computed from the object as it was just read. */
+export type UpdatePlan = { body: Record<string, unknown> } | { unchanged: true }
+
+export interface GuardedUpdateResult<T> {
+    status: 'ok' | 'unchanged' | 'dry_run'
+    before: T
+    /** The object the write returned. Undefined when nothing was written. */
+    after?: T
+    body?: Record<string, unknown>
+    /** True when the write counter shows another write landed in the race window. */
+    concurrentWriteDetected?: boolean
+    warning?: string
+}
+
+export interface GuardedUpdateOptions<T> {
+    /** The version the agent last read. When set and the object has moved on, nothing is written. */
+    baseVersion?: string | number | null | undefined
+    dryRun?: boolean | undefined
+    /** A pre-image the caller already read (a batch validates every item first). Skips the first read. */
+    base?: T | undefined
+    locks?: KeyedMutex
+}
+
+function pick(object: Record<string, unknown>, fields: readonly string[]): Record<string, unknown> {
+    const out: Record<string, unknown> = {}
+    for (const field of fields) {
+        if (Object.prototype.hasOwnProperty.call(object, field)) {
+            out[field] = object[field]
+        }
+    }
+    return out
+}
+
+/** The version marker plus the content of the fields about to be written. */
+export function fingerprint(
+    object: Record<string, unknown>,
+    markerFields: readonly string[],
+    writtenFields: readonly string[]
+): string {
+    return canonicalJson({ markers: pick(object, markerFields), fields: pick(object, writtenFields) })
+}
+
+function describeMarkers(object: Record<string, unknown>, markerFields: readonly string[]): string {
+    const markers = pick(object, markerFields)
+    const parts = Object.entries(markers).map(([key, value]) => `${key} ${JSON.stringify(value)}`)
+    return parts.length > 0 ? parts.join(', ') : 'content'
+}
+
+export async function versionCheckedUpdate<T extends Record<string, unknown>>(
+    resource: VersionedResource<T>,
+    plan: (current: T) => UpdatePlan | Promise<UpdatePlan>,
+    options: GuardedUpdateOptions<T> = {}
+): Promise<GuardedUpdateResult<T>> {
+    const locks = options.locks ?? objectLocks
+    return await locks.runExclusive(resource.lockKey, async () => {
+        const before = options.base ?? (await resource.read())
+
+        if (options.baseVersion !== undefined && options.baseVersion !== null) {
+            const current = resource.agentVersion(before)
+            if (String(current) !== String(options.baseVersion)) {
+                throw new WriteConflictError(
+                    `Conflict: ${resource.kind} ${resource.id} has changed since the version you read ` +
+                        `(you sent base_version ${JSON.stringify(options.baseVersion)}, it is now ${JSON.stringify(current)}). ` +
+                        `Nothing was written. Read it again and redo the change against the new version.`,
+                    { kind: resource.kind, id: resource.id, before: options.baseVersion, now: current }
+                )
+            }
+        }
+
+        const planned = await plan(before)
+        if ('unchanged' in planned) {
+            return { status: 'unchanged', before }
+        }
+        if (options.dryRun) {
+            return { status: 'dry_run', before, body: planned.body }
+        }
+
+        // Re-read immediately before writing: the narrowest window the REST API allows.
+        const writtenFields = Object.keys(planned.body).filter((field) => field !== 'version')
+        const check = await resource.read()
+        const expected = fingerprint(before, resource.markerFields, writtenFields)
+        if (fingerprint(check, resource.markerFields, writtenFields) !== expected) {
+            throw new WriteConflictError(
+                `Conflict: ${resource.kind} ${resource.id} was changed by someone else while this update was being ` +
+                    `prepared (${describeMarkers(before, resource.markerFields)} → ${describeMarkers(check, resource.markerFields)}). ` +
+                    `Nothing was written. Read it again and retry the change.`,
+                {
+                    kind: resource.kind,
+                    id: resource.id,
+                    before: pick(before, resource.markerFields),
+                    now: pick(check, resource.markerFields),
+                }
+            )
+        }
+
+        let after: T
+        try {
+            after = await resource.write(planned.body, before)
+        } catch (error) {
+            if (errorStatus(error) === 409) {
+                throw new WriteConflictError(
+                    `Conflict: the API refused the write because ${resource.kind} ${resource.id} changed after version ` +
+                        `${JSON.stringify(resource.agentVersion(before))}. Nothing was written. Read it again and retry the change.`,
+                    { kind: resource.kind, id: resource.id, before: resource.agentVersion(before) }
+                )
+            }
+            throw error
+        }
+
+        const result: GuardedUpdateResult<T> = { status: 'ok', before, after, body: planned.body }
+        const expectedCounter = resource.expectedCounterAfterWrite?.(before)
+        const actualCounter = isRecord(after) ? resource.counter?.(after) : undefined
+        if (expectedCounter !== undefined && actualCounter !== undefined && actualCounter > expectedCounter) {
+            result.concurrentWriteDetected = true
+            result.warning =
+                `Another write to ${resource.kind} ${resource.id} landed between the final check and this write ` +
+                `(version is ${actualCounter}, expected ${expectedCounter}). This change was applied, but it may have ` +
+                `replaced that other change. Read the ${resource.kind} again and check it before going on.`
+        }
+        return result
+    })
+}
