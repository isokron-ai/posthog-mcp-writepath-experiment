diff --git a/services/mcp/src/tools/atomic/annotationsBatch.ts b/services/mcp/src/tools/atomic/annotationsBatch.ts
new file mode 100644
index 00000000000..b362f4d1840
--- /dev/null
+++ b/services/mcp/src/tools/atomic/annotationsBatch.ts
@@ -0,0 +1,231 @@
+/**
+ * annotations-batch-create and annotations-batch-delete. See batch.ts for the semantics.
+ *
+ * Each create item is exactly annotation-create's input, validated by the same schema. Two items
+ * with the same content, date_marker and scope in one batch are refused unless skip_duplicates is off.
+ *
+ * Retrying a batch create is safe by default: with `skip_duplicates` (on unless turned off), an item
+ * whose content, date_marker and scope match a live annotation is reported `exists` with that
+ * annotation's id instead of being created twice. That makes a retry after a timeout or a partial
+ * failure idempotent, which a best-effort batch needs.
+ *
+ * Deletes are soft deletes, as annotation-delete does. An id that does not exist (or is already
+ * deleted) is reported `not_found` and does not block the rest: the end state the caller asked for
+ * already holds for it.
+ */
+import { z } from 'zod'
+
+import { canonicalJson } from '@/lib/plain-object'
+import type { Context, ToolBase } from '@/tools/types'
+
+import { MAX_BATCH_ITEMS, runBatch, type BatchResult, type ItemResult } from './batch'
+import { isNotFound } from './errors'
+import { type ApiObject, projectPath } from './resources'
+import { getAnnotationCreateSchema } from './validation'
+
+const preview = (content: unknown): string | null => {
+    if (typeof content !== 'string') {
+        return null
+    }
+    return content.length > 60 ? `${content.slice(0, 57)}...` : content
+}
+
+export const AnnotationsBatchCreateSchema = z.object({
+    items: z
+        .array(getAnnotationCreateSchema().describe('One annotation, with the same fields as annotation-create.'))
+        .min(1)
+        .max(MAX_BATCH_ITEMS)
+        .describe(`The annotations to create, at most ${MAX_BATCH_ITEMS} per call.`),
+    skip_duplicates: z
+        .boolean()
+        .optional()
+        .describe(
+            'Default true. Report an item whose content, date_marker and scope match a live annotation as `exists` instead of creating it again, so a retried batch does not duplicate.'
+        ),
+    dry_run: z.boolean().optional().describe('Validate every item and report what would be created, without writing.'),
+    stop_on_error: z
+        .boolean()
+        .optional()
+        .describe('Start no further creates after the first failed one. The rest are reported as skipped.'),
+})
+
+const sameInstant = (a: unknown, b: unknown): boolean =>
+    typeof a === 'string' && typeof b === 'string' && Date.parse(a) === Date.parse(b)
+
+async function findDuplicate(context: Context, projectId: string, item: ApiObject): Promise<ApiObject | undefined> {
+    if (typeof item.content !== 'string' || item.content.length === 0) {
+        return undefined
+    }
+    const page = await context.api.request<{ results?: ApiObject[] }>({
+        method: 'GET',
+        path: projectPath(projectId, 'annotations/'),
+        query: { search: item.content, limit: 100 },
+    })
+    const scope = item.scope ?? 'project'
+    return page.results?.find(
+        (row) =>
+            row.deleted !== true &&
+            row.content === item.content &&
+            sameInstant(row.date_marker, item.date_marker) &&
+            (row.scope ?? 'project') === scope &&
+            (row.dashboard_item ?? null) === (item.dashboard_item ?? null) &&
+            (row.dashboard_id ?? null) === (item.dashboard_id ?? null)
+    )
+}
+
+const createReceipt = (index: number, annotation: ApiObject, status: ItemResult['status']): ItemResult => ({
+    index,
+    status,
+    ...(annotation.id !== undefined ? { id: annotation.id as number } : {}),
+    content: preview(annotation.content),
+    date_marker: (annotation.date_marker as string | null | undefined) ?? null,
+    scope: (annotation.scope as string | undefined) ?? 'project',
+})
+
+export async function annotationsBatchCreate(
+    context: Context,
+    params: z.infer<typeof AnnotationsBatchCreateSchema>
+): Promise<BatchResult> {
+    const projectId = await context.stateManager.getProjectId()
+    const skipDuplicates = params.skip_duplicates ?? true
+    const seen = new Map<string, number>()
+    return await runBatch<ApiObject, ApiObject>({
+        items: params.items,
+        dryRun: params.dry_run ?? false,
+        stopOnError: params.stop_on_error ?? false,
+        prepare: async (raw, index) => {
+            const item = Object.fromEntries(Object.entries(raw).filter(([, value]) => value !== undefined))
+            if (!item.content || !item.date_marker) {
+                return {
+                    valid: false,
+                    result: { index, status: 'error', error: 'content and date_marker are required' },
+                }
+            }
+            const key = canonicalJson([
+                item.content,
+                Date.parse(String(item.date_marker)),
+                item.scope ?? 'project',
+                item.dashboard_item ?? null,
+                item.dashboard_id ?? null,
+            ])
+            const first = seen.get(key)
+            if (skipDuplicates && first !== undefined && first !== index) {
+                return {
+                    valid: false,
+                    result: { index, status: 'error', error: `same content, date_marker and scope as item ${first}` },
+                }
+            }
+            seen.set(key, first ?? index)
+            const existing = skipDuplicates ? await findDuplicate(context, projectId, item) : undefined
+            if (existing) {
+                return {
+                    valid: true,
+                    prepared: item,
+                    preview: createReceipt(index, existing, 'exists'),
+                    skipWrite: true,
+                }
+            }
+            return { valid: true, prepared: item, preview: createReceipt(index, item, 'would_change') }
+        },
+        execute: async (item, index) => {
+            const created = await context.api.request<ApiObject>({
+                method: 'POST',
+                path: projectPath(projectId, 'annotations/'),
+                body: item,
+            })
+            return createReceipt(index, created, 'ok')
+        },
+    })
+}
+
+export const AnnotationsBatchDeleteSchema = z.object({
+    ids: z
+        .array(z.number().int())
+        .min(1)
+        .max(MAX_BATCH_ITEMS)
+        .describe(`Ids of the annotations to soft-delete, at most ${MAX_BATCH_ITEMS} per call.`),
+    dry_run: z
+        .boolean()
+        .optional()
+        .describe('Check that every annotation exists and report what would be deleted, without deleting.'),
+    stop_on_error: z
+        .boolean()
+        .optional()
+        .describe('Start no further deletes after the first failed one. The rest are reported as skipped.'),
+})
+
+export async function annotationsBatchDelete(
+    context: Context,
+    params: z.infer<typeof AnnotationsBatchDeleteSchema>
+): Promise<BatchResult> {
+    const projectId = await context.stateManager.getProjectId()
+    const dryRun = params.dry_run ?? false
+    const ids = [...new Set(params.ids)]
+    const path = (id: number): string => projectPath(projectId, `annotations/${encodeURIComponent(String(id))}/`)
+    const gone = (index: number, id: number): ItemResult => ({
+        index,
+        id,
+        status: 'not_found',
+        error: 'No live annotation with this id (it may already be deleted).',
+    })
+    return await runBatch<number, number>({
+        items: ids,
+        dryRun,
+        stopOnError: params.stop_on_error ?? false,
+        prepare: async (id, index) => {
+            // A real delete needs no read first: the PATCH itself answers 404 for a missing id.
+            if (!dryRun) {
+                return { valid: true, prepared: id, preview: { index, id, status: 'would_change' } }
+            }
+            try {
+                const annotation = await context.api.request<ApiObject>({ method: 'GET', path: path(id) })
+                if (annotation.deleted === true) {
+                    return { valid: true, prepared: id, preview: gone(index, id), skipWrite: true }
+                }
+                return {
+                    valid: true,
+                    prepared: id,
+                    preview: { index, id, status: 'would_change', content: preview(annotation.content) },
+                }
+            } catch (error) {
+                if (isNotFound(error)) {
+                    return { valid: true, prepared: id, preview: gone(index, id), skipWrite: true }
+                }
+                throw error
+            }
+        },
+        execute: async (id, index) => {
+            try {
+                const deleted = await context.api.request<ApiObject>({
+                    method: 'PATCH',
+                    path: path(id),
+                    body: { deleted: true },
+                })
+                return {
+                    index,
+                    id,
+                    status: 'ok',
+                    content: preview(deleted.content),
+                    changed: { deleted: [false, true] },
+                }
+            } catch (error) {
+                if (isNotFound(error)) {
+                    return gone(index, id)
+                }
+                throw error
+            }
+        },
+    })
+}
+
+export const annotationsBatchCreateTool = (): ToolBase<typeof AnnotationsBatchCreateSchema, BatchResult> => ({
+    name: 'annotations-batch-create',
+    schema: AnnotationsBatchCreateSchema,
+    handler: annotationsBatchCreate,
+})
+
+export const annotationsBatchDeleteTool = (): ToolBase<typeof AnnotationsBatchDeleteSchema, BatchResult> => ({
+    name: 'annotations-batch-delete',
+    schema: AnnotationsBatchDeleteSchema,
+    handler: annotationsBatchDelete,
+})
diff --git a/services/mcp/src/tools/atomic/batch.ts b/services/mcp/src/tools/atomic/batch.ts
new file mode 100644
index 00000000000..c1c690968d7
--- /dev/null
+++ b/services/mcp/src/tools/atomic/batch.ts
@@ -0,0 +1,207 @@
+import { mapWithConcurrency } from './concurrency'
+/**
+ * Batch engine: validate every item, then write best-effort with a result per item.
+ *
+ * A batch over separate REST calls cannot be all-or-nothing: item 7's write can fail after items
+ * 1 to 6 are saved, and nothing rolls those back. So the engine makes two promises instead:
+ *
+ *   1. Validation before writes. Every item is checked first (input, the object exists, what would
+ *      change). If any item fails that check, nothing is written and every item says why it was
+ *      or was not attempted. A typo in item 7 never leaves items 1 to 6 half-applied.
+ *   2. Per-item results. Writes then run best-effort, a few at a time. Each item reports `ok` with
+ *      what changed, `unchanged`, or `error`/`conflict` with the reason, and the summary counts
+ *      them. With `stop_on_error`, no new writes start after the first failure; the rest are
+ *      reported `skipped`.
+ *
+ * `dry_run` runs step 1 only and reports what each item would do.
+ */
+import { WriteConflictError, errorMessage } from './errors'
+
+/** Most items one call may carry. Bigger jobs are split by the agent into several calls. */
+export const MAX_BATCH_ITEMS = 50
+
+/** Requests in flight at once. Rate limiting (429 + Retry-After) stays with ApiClient. */
+export const BATCH_CONCURRENCY = 4
+
+export const BATCH_SEMANTICS =
+    'Best-effort, not all-or-nothing: every item was validated before any write; writes that fail are reported per item and the others are kept.'
+
+export type ItemStatus =
+    | 'ok'
+    | 'unchanged'
+    | 'would_change'
+    | 'error'
+    | 'conflict'
+    | 'skipped'
+    | 'not_attempted'
+    | 'exists'
+    | 'not_found'
+
+export interface ItemResult {
+    index: number
+    status: ItemStatus
+    id?: string | number
+    /** Field-level receipt: `{field: [before, after]}`. */
+    changed?: Record<string, [unknown, unknown]>
+    error?: string
+    warning?: string
+    [extra: string]: unknown
+}
+
+export interface BatchSummary {
+    requested: number
+    ok: number
+    unchanged: number
+    failed: number
+    skipped: number
+    written: number
+    dry_run: boolean
+    atomic: false
+    semantics: string
+    aborted?: string
+}
+
+/**
+ * What the agent receives per item. `changed` is one short line, `field: old → new; ...`, so that a
+ * batch of uniform items prints as one table row each instead of a nested block per item.
+ */
+export type ItemReceipt = Omit<ItemResult, 'changed'> & { changed?: string }
+
+export interface BatchResult {
+    summary: BatchSummary
+    items: ItemReceipt[]
+}
+
+export type Prepared<P> =
+    | { valid: true; prepared: P; preview: ItemResult; skipWrite?: boolean }
+    | { valid: false; result: ItemResult }
+
+export interface BatchSpec<I, P> {
+    items: readonly I[]
+    dryRun: boolean
+    stopOnError: boolean
+    /** Validation phase: reads only. Returns the prepared write and a preview of the result. */
+    prepare: (item: I, index: number) => Promise<Prepared<P>>
+    /** Write phase. Throw to report the item as failed; the batch goes on. */
+    execute: (prepared: P, index: number) => Promise<ItemResult>
+}
+
+const FAILED: ItemStatus[] = ['error', 'conflict']
+
+export function summarize(items: ItemResult[], dryRun: boolean, written: number, aborted?: string): BatchSummary {
+    const count = (statuses: ItemStatus[]): number => items.filter((item) => statuses.includes(item.status)).length
+    return {
+        requested: items.length,
+        ok: count(['ok', 'would_change']),
+        unchanged: count(['unchanged', 'exists', 'not_found']),
+        failed: count(FAILED),
+        skipped: count(['skipped', 'not_attempted']),
+        written,
+        dry_run: dryRun,
+        atomic: false,
+        semantics: BATCH_SEMANTICS,
+        ...(aborted ? { aborted } : {}),
+    }
+}
+
+export async function runBatch<I, P>(spec: BatchSpec<I, P>): Promise<BatchResult> {
+    const prepared = (await mapWithConcurrency(spec.items, BATCH_CONCURRENCY, async (item, index) => {
+        try {
+            return await spec.prepare(item, index)
+        } catch (error) {
+            return { valid: false, result: { index, status: 'error', error: errorMessage(error) } } as Prepared<P>
+        }
+    })) as Prepared<P>[]
+
+    const invalid = prepared.filter((entry) => !entry.valid)
+    if (invalid.length > 0) {
+        const items = prepared.map((entry, index): ItemResult => {
+            if (!entry.valid) {
+                return entry.result
+            }
+            return { ...entry.preview, index, status: 'not_attempted' }
+        })
+        return {
+            summary: summarize(
+                items,
+                spec.dryRun,
+                0,
+                `${invalid.length} item(s) failed validation, so nothing was written. Fix them and send the batch again.`
+            ),
+            items: items.map(toReceipt),
+        }
+    }
+
+    if (spec.dryRun) {
+        const items = prepared.map((entry) => (entry.valid ? entry.preview : entry.result))
+        return { summary: summarize(items, true, 0), items: items.map(toReceipt) }
+    }
+
+    let failed = false
+    let written = 0
+    const outcomes = await mapWithConcurrency(
+        prepared,
+        BATCH_CONCURRENCY,
+        async (entry, index): Promise<ItemResult> => {
+            if (!entry.valid) {
+                return entry.result
+            }
+            if (entry.skipWrite) {
+                return entry.preview
+            }
+            try {
+                const result = await spec.execute(entry.prepared, index)
+                if (result.status === 'ok') {
+                    written++
+                }
+                return result
+            } catch (error) {
+                failed = true
+                return {
+                    ...entry.preview,
+                    index,
+                    status: error instanceof WriteConflictError ? 'conflict' : 'error',
+                    changed: undefined,
+                    error: errorMessage(error),
+                }
+            }
+        },
+        () => spec.stopOnError && failed
+    )
+    const items = outcomes.map((outcome, index): ItemResult => {
+        if (outcome) {
+            return outcome
+        }
+        const entry = prepared[index]!
+        const preview = entry.valid ? entry.preview : entry.result
+        return {
+            ...preview,
+            index,
+            status: 'skipped',
+            changed: undefined,
+            error: 'Not started: an earlier write failed and stop_on_error is set.',
+        }
+    })
+    return { summary: summarize(items, false, written), items: items.map(toReceipt) }
+}
+
+function short(value: unknown): string {
+    const text = JSON.stringify(value ?? null)
+    return text.length > 80 ? `${text.slice(0, 77)}...` : text
+}
+
+/** `tags: [] → ["legacy"]; deleted: false → true` */
+export function describeChanges(changed: Record<string, [unknown, unknown]>): string {
+    return Object.entries(changed)
+        .map(([field, [before, after]]) => `${field}: ${short(before)} → ${short(after)}`)
+        .join('; ')
+}
+
+function toReceipt(item: ItemResult): ItemReceipt {
+    const { changed, ...rest } = item
+    const receipt = Object.fromEntries(Object.entries(rest).filter(([, value]) => value !== undefined)) as ItemReceipt
+    if (changed && Object.keys(changed).length > 0) {
+        receipt.changed = describeChanges(changed)
+    }
+    return receipt
+}
diff --git a/services/mcp/src/tools/atomic/concurrency.ts b/services/mcp/src/tools/atomic/concurrency.ts
new file mode 100644
index 00000000000..f53a90e20cf
--- /dev/null
+++ b/services/mcp/src/tools/atomic/concurrency.ts
@@ -0,0 +1,67 @@
+/**
+ * Concurrency primitives for the atomic-write and batch tools.
+ *
+ * - `KeyedMutex` serializes work on one key (one object) inside this server process. Two partial
+ *   updates of the same insight sent through this process therefore run one after the other, and
+ *   the second reads the first one's result. It does not reach other processes or the PostHog UI;
+ *   the version check in versionGuard.ts covers those.
+ * - `mapWithConcurrency` fans work out with a fixed number of requests in flight, so a batch does
+ *   not burst the API. Rate limiting itself stays with ApiClient, which retries a 429 after the
+ *   API's Retry-After.
+ */
+
+export class KeyedMutex {
+    private readonly tails = new Map<string, Promise<void>>()
+
+    /** Runs `task` once every earlier task on `key` has settled. Different keys run in parallel. */
+    async runExclusive<T>(key: string, task: () => Promise<T>): Promise<T> {
+        const previous = this.tails.get(key) ?? Promise.resolve()
+        let release!: () => void
+        const current = new Promise<void>((resolve) => {
+            release = resolve
+        })
+        const tail = previous.then(() => current)
+        this.tails.set(key, tail)
+        await previous
+        try {
+            return await task()
+        } finally {
+            release()
+            // Drop the entry once nothing is queued behind this task, so the map does not grow.
+            if (this.tails.get(key) === tail) {
+                this.tails.delete(key)
+            }
+        }
+    }
+
+    /** Number of keys with a task running or queued. For tests. */
+    get size(): number {
+        return this.tails.size
+    }
+}
+
+/** One mutex per server process, shared by every tool that does a read-merge-write. */
+export const objectLocks = new KeyedMutex()
+
+/**
+ * Maps `items` through `worker` with at most `limit` calls in flight, keeping input order in the
+ * output. `shouldStop` is checked before each new item starts; once it returns true, the remaining
+ * items are not started and come back as `undefined`.
+ */
+export async function mapWithConcurrency<T, R>(
+    items: readonly T[],
+    limit: number,
+    worker: (item: T, index: number) => Promise<R>,
+    shouldStop: () => boolean = () => false
+): Promise<(R | undefined)[]> {
+    const results: (R | undefined)[] = new Array(items.length).fill(undefined)
+    let next = 0
+    const lanes = Array.from({ length: Math.max(1, Math.min(limit, items.length)) }, async () => {
+        while (next < items.length && !shouldStop()) {
+            const index = next++
+            results[index] = await worker(items[index]!, index)
+        }
+    })
+    await Promise.all(lanes)
+    return results
+}
diff --git a/services/mcp/src/tools/atomic/errors.ts b/services/mcp/src/tools/atomic/errors.ts
new file mode 100644
index 00000000000..d676b527150
--- /dev/null
+++ b/services/mcp/src/tools/atomic/errors.ts
@@ -0,0 +1,68 @@
+/**
+ * Errors for the atomic-write and batch tools.
+ *
+ * Both classes extend PostHogApiError so handleToolError returns their message to the agent as is.
+ * A 4xx status keeps them out of exception capture: a conflict or a refused write is an expected
+ * outcome the agent recovers from, not a server bug.
+ */
+import { PostHogApiError, PostHogValidationError } from '@/lib/errors'
+
+/**
+ * The object changed between the read and the write, so nothing was written. The agent should
+ * read the object again and retry against the new version.
+ */
+export class WriteConflictError extends PostHogApiError {
+    constructor(
+        message: string,
+        public readonly details: { kind: string; id: string | number; before?: unknown; now?: unknown }
+    ) {
+        super({
+            status: 409,
+            statusText: 'Conflict',
+            body: '',
+            url: '',
+            method: 'PATCH',
+            message,
+        })
+        this.name = 'WriteConflictError'
+    }
+}
+
+/**
+ * A multi-step write failed part-way. The message says which step failed, what was rolled back,
+ * and anything left behind. The status is the failed step's own status (500 when it had none).
+ */
+export class AtomicWriteError extends PostHogApiError {
+    constructor(message: string, cause: unknown) {
+        super({
+            status: errorStatus(cause) ?? 500,
+            statusText: 'Atomic write failed',
+            body: '',
+            url: '',
+            method: 'POST',
+            message,
+        })
+        this.name = 'AtomicWriteError'
+    }
+}
+
+export function errorStatus(error: unknown): number | undefined {
+    if (error instanceof PostHogApiError) {
+        return error.status
+    }
+    if (error instanceof PostHogValidationError) {
+        return 400
+    }
+    return undefined
+}
+
+/** One line for a per-item result or a rollback report. */
+export function errorMessage(error: unknown): string {
+    const text = error instanceof Error ? error.message : String(error)
+    return text.length > 500 ? `${text.slice(0, 500)}…` : text
+}
+
+/** True when the API said the object does not exist (or is soft-deleted, which reads as 404). */
+export function isNotFound(error: unknown): boolean {
+    return error instanceof PostHogApiError && error.status === 404
+}
