From 05e005573b0fffd050f5b919660ed2c8ebb40134 Mon Sep 17 00:00:00 2001
From: Rafe Walker <45343084+rafe-walker@users.noreply.github.com>
Date: Mon, 9 Nov 2026 19:47:36 -0700
Subject: [PATCH] fix(mcp): accept any whitespace between exec command parts

The exec parser split a command on the first space only, so a JSON body
that started on the line after the tool name, or after a tab, was read as
part of the tool name. The agent was told an existing tool was unknown and
was pointed at a search for the tool name plus the JSON fragment.

parseCommand now splits on the first whitespace of any kind, which is what
the batch splitter's firstToken already does.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 services/mcp/src/tools/exec.ts       |  3 ++-
 services/mcp/tests/unit/exec.test.ts | 20 ++++++++++++++++++++
 2 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/services/mcp/src/tools/exec.ts b/services/mcp/src/tools/exec.ts
index 97b15cd09bf..e18576b5c53 100644
--- a/services/mcp/src/tools/exec.ts
+++ b/services/mcp/src/tools/exec.ts
@@ -316,9 +316,10 @@ function makeExecSchema(commandReference: string): z.ZodObject<{ command: z.ZodS
     })
 }
 
+/** Splits on the first whitespace of any kind: a JSON body often starts on the line after the tool name. */
 function parseCommand(input: string): { verb: string; rest: string } {
     const trimmed = input.trim()
-    const idx = trimmed.indexOf(' ')
+    const idx = trimmed.search(/\s/)
     if (idx === -1) {
         return { verb: trimmed, rest: '' }
     }
diff --git a/services/mcp/tests/unit/exec.test.ts b/services/mcp/tests/unit/exec.test.ts
index af5194ae7a1..721bb67b0da 100644
--- a/services/mcp/tests/unit/exec.test.ts
+++ b/services/mcp/tests/unit/exec.test.ts
@@ -1409,6 +1409,24 @@ describe('exec tool', () => {
             const exec = createExec([tool])
             await expect(exec.handler(mockContext, { command })).resolves.toBeDefined()
         })
+
+        // A body on its own line used to be read as part of the tool name, so an existing
+        // tool came back as unknown.
+        it.each([
+            ['a JSON body on the line after the tool name', 'call mock-tool\n{"query": "SELECT 1"}'],
+            ['a pretty-printed JSON body on the next line', 'call mock-tool\n{\n  "query": "SELECT 1"\n}'],
+            ['a tab before the JSON body', 'call mock-tool\t{"query": "SELECT 1"}'],
+            ['a non-breaking space before the JSON body', 'call mock-tool\u00a0{"query": "SELECT 1"}'],
+            ['the tool name on the line after the verb', 'call\nmock-tool {"query": "SELECT 1"}'],
+        ])('passes the body to the tool with %s', async (_label, command) => {
+            const handler = vi.fn(async () => ({ ok: true }))
+            const tool = makeMockTool({ schema: z.object({ query: z.string().optional() }), handler })
+            const exec = createExec([tool])
+
+            await exec.handler(mockContext, { command })
+
+            expect(handler).toHaveBeenCalledWith(mockContext, { query: 'SELECT 1' })
+        })
     })
 
     describe('info command', () => {
@@ -2226,6 +2244,8 @@ describe('exec tool', () => {
             ['call --confirm my-tool {}', 'my-tool'],
             ['call --json --confirm my-tool {}', 'my-tool'],
             ['  call   my-tool   {}  ', 'my-tool'],
+            ['call my-tool\n{}', 'my-tool'],
+            ['call\tmy-tool\t{}', 'my-tool'],
         ])('extracts inner tool name from "%s"', (command, expected) => {
             expect(parseExecCallInnerToolName(command)).toBe(expected)
         })
