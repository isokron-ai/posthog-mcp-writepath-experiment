From 246a74da2898777ec726758b6172a35f9d7f9963 Mon Sep 17 00:00:00 2001
From: Rafe Walker <45343084+rafe-walker@users.noreply.github.com>
Date: Mon, 9 Nov 2026 20:37:37 -0700
Subject: [PATCH] fix(mcp): accept real comment ids in tasks-comments-retrieve

Comment ids are UUIDTs. Their third group is a per-millisecond counter and
their fourth group is random, so they rarely carry the RFC 4122 version and
variant digits that z.string().uuid() requires. Ids returned by
tasks-comments-list were rejected with "Invalid UUID".

Both id fields now use z.guid(), as external-data-sync-logs already does.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 services/mcp/src/tools/tasksContext.ts        |  6 ++++--
 .../tool-schemas/tasks-comments-retrieve.json |  4 ++--
 services/mcp/tests/unit/tasks-context.test.ts | 19 +++++++++++++++++++
 3 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/services/mcp/src/tools/tasksContext.ts b/services/mcp/src/tools/tasksContext.ts
index f803af93858..4c253b3ae9a 100644
--- a/services/mcp/src/tools/tasksContext.ts
+++ b/services/mcp/src/tools/tasksContext.ts
@@ -32,11 +32,13 @@ const commentsListSchema = z.object({
     limit: z.number().int().min(1).max(100).default(50).describe('Maximum root comments to return. Defaults to 50.'),
     cursor: z.string().min(1).max(256).optional().describe('Opaque cursor returned by a previous call.'),
 })
+// Comment ids are UUIDTs, whose version and variant digits do not follow RFC 4122,
+// so `z.uuid()` rejects them. `z.guid()` accepts any 8-4-4-4-12 hex string.
 const commentsRetrieveSchema = z.object({
-    root_comment_id: z.string().uuid().describe('Root comment id returned by tasks-comments-list.'),
+    root_comment_id: z.guid().describe('Root comment id returned by tasks-comments-list.'),
     limit: z.number().int().min(1).max(100).default(50).describe('Maximum comments to return. Defaults to 50.'),
     cursor: z.string().min(1).max(256).optional().describe('Opaque cursor returned by a previous call.'),
-    comment_id: z.string().uuid().optional().describe('Comment id whose truncated body should continue.'),
+    comment_id: z.guid().optional().describe('Comment id whose truncated body should continue.'),
     content_offset: z
         .number()
         .int()
diff --git a/services/mcp/tests/unit/__snapshots__/tool-schemas/tasks-comments-retrieve.json b/services/mcp/tests/unit/__snapshots__/tool-schemas/tasks-comments-retrieve.json
index 22eb9be51bc..b08b11f021b 100644
--- a/services/mcp/tests/unit/__snapshots__/tool-schemas/tasks-comments-retrieve.json
+++ b/services/mcp/tests/unit/__snapshots__/tool-schemas/tasks-comments-retrieve.json
@@ -4,7 +4,7 @@
         "comment_id": {
             "description": "Comment id whose truncated body should continue.",
             "format": "uuid",
-            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
+            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
             "type": "string"
         },
         "content_offset": {
@@ -29,7 +29,7 @@
         "root_comment_id": {
             "description": "Root comment id returned by tasks-comments-list.",
             "format": "uuid",
-            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
+            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
             "type": "string"
         }
     },
diff --git a/services/mcp/tests/unit/tasks-context.test.ts b/services/mcp/tests/unit/tasks-context.test.ts
index e4591d6c5f1..f50ceb3615b 100644
--- a/services/mcp/tests/unit/tasks-context.test.ts
+++ b/services/mcp/tests/unit/tasks-context.test.ts
@@ -88,6 +88,25 @@ describe('task artifacts and comments tools', () => {
         ])
     })
 
+    // A UUIDT has a per-millisecond counter where RFC 4122 has the version digit, and
+    // random bytes where it has the variant digit, so a strict UUID check rejects it.
+    it.each([
+        ['root_comment_id', { root_comment_id: '01a1aa05-0f82-0000-39df-151783a90003' }],
+        [
+            'comment_id',
+            {
+                root_comment_id: '019fcdb5-2e5b-7ab1-bdab-b77fafd3c96f',
+                comment_id: '01a1aa05-0f82-0001-c4df-151783a90004',
+            },
+        ],
+    ])('accepts a UUIDT comment id as %s', (_field, input) => {
+        expect(tasksCommentsRetrieve().schema.safeParse(input).success).toBe(true)
+    })
+
+    it('rejects a comment id that is not a UUID', () => {
+        expect(tasksCommentsRetrieve().schema.safeParse({ root_comment_id: 'not-an-id' }).success).toBe(false)
+    })
+
     it('fails closed when the host did not stamp a task', async () => {
         const { context: toolContext, request } = context(undefined)
 
