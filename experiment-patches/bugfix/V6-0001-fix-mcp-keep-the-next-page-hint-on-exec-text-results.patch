From 6929daf9332a1006d00980be49006feb1925149c Mon Sep 17 00:00:00 2001
From: Rafe Walker <45343084+rafe-walker@users.noreply.github.com>
Date: Mon, 9 Nov 2026 20:37:37 -0700
Subject: [PATCH] fix(mcp): keep the next-page hint on exec text results

The footer that tells an agent how to read the next page of a list was
only added on the direct tool path. The exec text path never got it. For
list tools that return a plain paginated response, exec keeps only the
rows, so `next` and `count` are gone too and a partial page reads as the
whole list.

The exec text branch now appends the same footer.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 services/mcp/src/tools/exec.ts       |  8 ++++++++
 services/mcp/tests/unit/exec.test.ts | 19 +++++++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/services/mcp/src/tools/exec.ts b/services/mcp/src/tools/exec.ts
index 97b15cd09bf..8c076c78f2d 100644
--- a/services/mcp/src/tools/exec.ts
+++ b/services/mcp/src/tools/exec.ts
@@ -17,6 +17,7 @@ import {
 import { estimateTokens } from '@/lib/estimate-tokens'
 import { GATEWAY_TOOL_SEPARATOR, isGatewayToolName } from '@/lib/gateway-tools'
 import { findIgnoredInputKeys, withIgnoredInputKeys } from '@/lib/ignored-input-keys'
+import { getNextPageHint } from '@/lib/next-page-hint'
 import { isChatGptAppConnection } from '@/lib/oauth-constants'
 import type { RequestProperties } from '@/lib/request-properties'
 import { formatResponse } from '@/lib/response'
@@ -2364,6 +2365,13 @@ export function createExecTool(
                         // and crowd it out — buildToolResultPayload makes the same choice for
                         // the non-exec path, this keeps exec consistent.
                         outputText = typeof formattedOverride === 'string' ? formattedOverride : formatResponse(result)
+                        // `formatResponse` keeps only the rows of a paginated envelope, so `next`
+                        // and `count` are gone from the text. Without this footer a partial page
+                        // reads as the whole list.
+                        const nextPageHint = getNextPageHint(tool.name, result)
+                        if (nextPageHint) {
+                            outputText = `${outputText}\n\n${nextPageHint}`
+                        }
                     }
                     trackInnerCall?.(tool.name, {
                         duration_ms: durationMs,
diff --git a/services/mcp/tests/unit/exec.test.ts b/services/mcp/tests/unit/exec.test.ts
index af5194ae7a1..4819dac79be 100644
--- a/services/mcp/tests/unit/exec.test.ts
+++ b/services/mcp/tests/unit/exec.test.ts
@@ -368,6 +368,25 @@ describe('exec tool', () => {
             }
         )
 
+        it('tells the agent how to read the next page of a partial list', async () => {
+            const handlerResult = {
+                count: 230,
+                next: 'https://example.com/api/projects/1/things/?limit=100&offset=100',
+                previous: null,
+                results: [{ id: 1 }, { id: 2 }, { id: 3 }],
+            }
+            const exec = createExec([makeMockTool({ handler: async () => handlerResult })])
+
+            const text = await exec.handler(mockContext, { command: 'call mock-tool' })
+            const json = await exec.handler(mockContext, { command: 'call --json mock-tool' })
+
+            expect(text).toBe(
+                `${formatResponse(handlerResult.results)}\n\nShowing 3 of 230 results. More results exist: call mock-tool again with the same arguments and set offset=100 and limit=100 to get the next page.`
+            )
+            // JSON output keeps `next` and `count`, so it needs no footer.
+            expect(json).toBe(JSON.stringify(handlerResult))
+        })
+
         it('returns raw JSON when --json flag is passed in command', async () => {
             const exec = createExec()
             const result = await exec.handler(mockContext, { command: 'call --json mock-tool' })
