 services/mcp/src/tools/generated/core.ts      | 38 +++++++++++++-
 .../user-settings-update-response.test.ts     | 49 +++++++++++++++++++
 3 files changed, 122 insertions(+), 1 deletion(-)
 create mode 100644 services/mcp/tests/unit/user-settings-update-response.test.ts

