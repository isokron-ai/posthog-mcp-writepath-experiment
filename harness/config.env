# Non-secret settings for the PostHog MCP benchmark harness (template: fill in the <FILL_ME> values).
# No key is stored here: key files are named by path and read by path only, never printed.
#
# The values below the next line are the TARGET=cloud settings. TARGET=cloud exists for harness development only:
# PostHog's Cloud terms of service (section 2.1(i)) restrict benchmarking PostHog Cloud and publishing the results
# without PostHog's written consent. Every published IsoKron result used TARGET=selfhosted (config.selfhosted.env).
POSTHOG_HOST=https://us.posthog.com
# Your dedicated TEST project. The preflight refuses to run unless the key resolves to exactly this project
# and that project's organization id equals EXPECTED_ORG_ID.
POSTHOG_PROJECT_ID=<FILL_ME>
EXPECTED_ORG_ID=
POSTHOG_KEY_FILE=
# Path of a file whose first line is your Anthropic API key (mode 600). The runs are billed to that key.
ANTHROPIC_KEY_FILE=
# Global ceiling on harness-originated requests to PostHog (seed, reset, checkers, cleanup, probes).
MAX_REQUESTS_PER_SECOND=2
# Agent
BENCH_MODEL=claude-sonnet-5-5
BENCH_BUDGET_USD=40
# MCP server mode a normal client gets: "cli" = one `exec` tool wrapping the whole catalog (the server default
# for every client except Cursor). "tools" would list one MCP tool per PostHog tool; do not use it unfiltered.
MCP_MODE=cli
# Optional feature filter (?features=...). Empty = what a default install gets.
MCP_FEATURES=
# Local ports (loopback only)
MCP_SERVER_PORT=8791
MCP_PROXY_PORT=8792
REDIS_PORT=6399
REDIS_CONTAINER=posthog-audit-redis
REDIS_IMAGE=redis:7.0.10
