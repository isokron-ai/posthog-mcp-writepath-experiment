# TARGET=selfhosted overlay on config.env (template: fill in the <FILL_ME> values): a local PostHog open-source
# instance set up with ../selfhost (official hobby deployment, loopback only, no outbound network; see
# ../selfhost/docker-compose.localhost.yml). lib/target.py refuses unless this file itself defines host, project,
# org and key file, and the host is loopback; it is the only target the harness accepts. The key is read by path only, never printed.
# Relative paths are resolved from the directory you run the harness commands in: run them from harness/.
POSTHOG_HOST=http://127.0.0.1:8010
# Printed by ../selfhost/local/create-account.py (project_id and organization_id).
POSTHOG_PROJECT_ID=<FILL_ME>
EXPECTED_ORG_ID=<FILL_ME>
# Written by ../selfhost/local/create-account.py (mode 600). An absolute path also works.
POSTHOG_KEY_FILE=../selfhost/.secrets/api-key
SELFHOST_DIR=../selfhost
# what the agent sees per build on this target (initialize + tools/list), per build
CATALOG_DIR=catalog/selfhosted
# loopback port on which server/local-runtime.mjs serves the pinned skills archives (server/assets/) to the MCP server
MCP_ASSETS_PORT=8793
# harness PostHog requests per clock hour (lib/ph.py caps it at 3600; its default is 2400).
MAX_REQUESTS_PER_HOUR=3600
